{
    "name": "smartlinker/smartlinker",
    "description": "Internal linking for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "bin/test.sh",
        "test:php": "phpunit",
        "test:js": "node --test \"tests/js/*.test.mjs\""
    },
    "config": {
        "optimize-autoloader": true
    }
}
